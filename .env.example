# MiniMax (OpenAI-compatible) defaults — matches the original ai_text_editor.
# Both fields are optional. The in-app Settings modal can override them.
# - VITE_DEFAULT_API_ENDPOINT: full chat completions URL or just a base.
#   If a base is given, the app appends /chat/completions.
# - VITE_DEFAULT_MODEL: model id sent in the request body.
VITE_DEFAULT_API_ENDPOINT=https://api.minimax.io/v1
VITE_DEFAULT_MODEL=MiniMax-M2.7
